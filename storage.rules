rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/audio/{fileName} {
      // Any authenticated user can read (stream/download) audio so shared
      // project recipients can play and cache tracks from the owner's path.
      allow read: if request.auth != null;

      // Only the owner can upload or delete their own audio files.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/covers/{fileName} {
      // Any authenticated user can download cover images for shared projects.
      allow read: if request.auth != null;

      // Only the owner can upload or delete their own cover images.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{fileName} {
      // Profile pictures are visible to signed-in collaborators. Only the
      // account owner may upload an image, capped at 5 MB and JPEG-only.
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }
  }
}
