rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Version audio has a dedicated path so visibility is enforced server-side.
    // A public version is readable only by the owner or an accepted project invitee.
    match /users/{userId}/audio/versions/{versionId}/{fileName} {
      function collaboratorCanReadVersion() {
        let access = firestore.get(
          /databases/(default)/documents/users/$(userId)/versionAccess/$(versionId)
        );
        return access.data.isPublic == true
          && firestore.exists(
            /databases/(default)/documents/users/$(userId)/projects/$(access.data.projectID)/invitees/$(request.auth.uid)
          );
      }

      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || collaboratorCanReadVersion()
        );

      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/audio/{fileName} {
      // Any authenticated user can read (stream/download) audio so shared
      // project recipients can play and cache tracks from the owner's path.
      allow read: if request.auth != null;

      // Only the owner can upload or delete their own audio files.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/covers/{fileName} {
      // Any authenticated user can download cover images for shared projects.
      allow read: if request.auth != null;

      // Only the owner can upload or delete their own cover images.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{fileName} {
      // Profile pictures are visible to signed-in collaborators. Only the
      // account owner may upload an image, capped at 5 MB and JPEG-only.
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }
  }
}
