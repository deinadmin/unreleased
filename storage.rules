rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/audio/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/covers/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
